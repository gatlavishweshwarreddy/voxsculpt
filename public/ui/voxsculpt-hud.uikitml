<style>
  .root {
    flex-direction: column;
    align-items: stretch;
    width: 58;
    background-color: rgba(8, 10, 18, 0.88);
    border-color: rgba(80, 140, 255, 0.35);
    border-width: 0.4;
    border-radius: 4;
    padding-top: 3.5;
    padding-bottom: 3.5;
    padding-left: 4;
    padding-right: 4;
    gap: 2.5;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .title {
    font-size: 3.8;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    text-align: left;
  }

  .subtitle {
    font-size: 2.4;
    color: rgba(120, 165, 255, 0.75);
    text-align: left;
  }

  .divider {
    width: 100%;
    height: 0.3;
    background-color: rgba(80, 140, 255, 0.2);
    border-radius: 1;
  }

  .stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .stat-label {
    font-size: 2.2;
    color: rgba(160, 185, 255, 0.7);
    text-align: left;
  }

  .stat-value {
    font-size: 2.6;
    font-weight: 600;
    color: rgba(100, 190, 255, 1.0);
    text-align: right;
  }

  .gesture-hint {
    flex-direction: row;
    align-items: center;
    gap: 1.5;
    background-color: rgba(255, 200, 80, 0.08);
    border-color: rgba(255, 200, 80, 0.25);
    border-width: 0.3;
    border-radius: 2.5;
    padding-top: 1.8;
    padding-bottom: 1.8;
    padding-left: 2.5;
    padding-right: 2.5;
  }

  .hint-text {
    font-size: 2.0;
    color: rgba(255, 215, 120, 0.85);
    text-align: left;
  }

  .onboard-hint {
    flex-direction: column;
    align-items: flex-start;
    background-color: rgba(40, 20, 80, 0.82);
    border-color: rgba(160, 100, 255, 0.55);
    border-width: 0.4;
    border-radius: 3;
    padding-top: 2.5;
    padding-bottom: 2.5;
    padding-left: 3;
    padding-right: 3;
    gap: 1.8;
  }

  .onboard-text {
    font-size: 2.5;
    font-weight: 600;
    color: rgba(230, 210, 255, 0.96);
    text-align: left;
  }

  .onboard-skip {
    font-size: 1.8;
    color: rgba(160, 130, 220, 0.7);
    text-align: left;
    cursor: pointer;
  }

  .btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 2;
  }

  .btn-label {
    font-size: 2.4;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    text-align: center;
  }

  .footer-hint {
    font-size: 1.9;
    color: rgba(100, 120, 180, 0.6);
    text-align: center;
  }
</style>
<Panel id="hud-root" class="root">

  <!-- Header -->
  <div class="header">
    <span class="title">VoxSculpt</span>
    <span class="subtitle">AR Sculpting</span>
  </div>

  <!-- Onboarding hint — single element; OnboardingSystem updates text via setProperties -->
  <div id="hint-box" class="onboard-hint">
    <span id="hint-text" class="onboard-text">Pinch to place your first block</span>
    <span id="hint-skip" class="onboard-skip">Skip tutorial</span>
  </div>

  <div class="divider"></div>

  <!-- Voxel count -->
  <div class="stat-row">
    <span class="stat-label">Placed voxels</span>
    <span id="txt-count" class="stat-value">0 voxels</span>
  </div>

  <!-- Undo hint — hidden until there is something to undo -->
  <div id="btn-undo-hint" class="gesture-hint" style="display: none">
    <span class="hint-text">Pinch both hands then release to undo</span>
  </div>

  <div class="divider"></div>

  <!-- Gesture cheat-sheet -->
  <div class="stat-row">
    <span class="stat-label">Pinch to place</span>
    <span class="stat-label">Touch palette to color</span>
  </div>
  <div class="stat-row">
    <span class="stat-label">Throw to delete</span>
    <span class="stat-label">Both pinch = undo</span>
  </div>

  <div class="divider"></div>

  <!-- Action buttons -->
  <div class="btn-row">
    <Button id="btn-export">
      <ButtonLabel class="btn-label">Export .gltf</ButtonLabel>
    </Button>
    <Button id="btn-clear">
      <ButtonLabel class="btn-label">Clear</ButtonLabel>
    </Button>
  </div>

  <!-- XR launch / exit (wired by PanelSystem) -->
  <Button id="xr-button" style="display: none">
    <ButtonLabel class="btn-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" style="display: none">
    <ButtonLabel class="btn-label">Exit XR</ButtonLabel>
  </Button>

  <span class="footer-hint">Meta Quest - Hand Tracking - WebXR</span>

</Panel>
